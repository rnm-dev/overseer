# Copy to .kamal/secrets and provide values through the controller environment
# or a secrets manager. Never commit literal production credentials.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=$DATABASE_URL
OVERSEER_GITHUB_CLIENT_ID=$OVERSEER_GITHUB_CLIENT_ID
OVERSEER_GITHUB_CLIENT_SECRET=$OVERSEER_GITHUB_CLIENT_SECRET
OVERSEER_RELEASE_TOKEN=$OVERSEER_RELEASE_TOKEN
