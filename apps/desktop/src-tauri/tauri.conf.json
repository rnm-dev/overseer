{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peon",
  "version": "0.1.0",
  "identifier": "dev.rnm.peon.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Peon", "width": 440, "height": 620, "minWidth": 380, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "runtime/": "runtime/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "installer-hooks.nsh" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
