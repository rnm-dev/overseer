node_modules/
# dist/ is committed pre-built (the compiled daemon/dashboard/CLI a global npm install runs —
# see CLAUDE.md). Building it from `prepare` on a global `npm install -g git+...` is unreliable
# (npm doesn't install devDeps like typescript for a global git build → `tsc: not found`), so
# the compiled output is checked in and carried into the install via package.json's "files".
# Run `npm run compile` and commit dist/ after editing anything under src/.
*.log
.env
.env.*
/worktrees/
/.dev-data/
