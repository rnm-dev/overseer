{
  "name": "@rnm-dev/peon",
  "version": "0.12.3",
  "description": "peon — autonomous coding agent daemon and CLI, managed through Overseer",
  "license": "MIT",
  "author": "RNM Dev",
  "homepage": "https://github.com/rnm-dev/overseer/tree/master/apps/peon#readme",
  "bugs": {
    "url": "https://github.com/rnm-dev/overseer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnm-dev/overseer.git",
    "directory": "apps/peon"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "peon": "dist/cli/peon.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:daemon": "tsx watch src/daemon/index.ts",
    "peon": "tsx src/cli/peon.ts",
    "pretest": "npm run check:architecture-imports",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:architecture-imports": "node --test scripts/check-architecture-imports.test.mjs",
    "benchmark:transcript-pagination": "node --expose-gc --import tsx scripts/benchmark-transcript-pagination.ts",
    "compile": "tsc -p tsconfig.json && node scripts/clean-obsolete-dist.mjs && node scripts/fixCliShebang.mjs",
    "prepack": "npm run compile",
    "prepublishOnly": "npm run typecheck && npm test",
    "verify": "npm run typecheck && npm test && npm run compile",
    "repair:transcript-timestamps": "node scripts/repair-transcript-timestamps.mjs",
    "restart:daemon": "bash scripts/restart-daemon.sh",
    "update": "tsx src/cli/update.ts",
    "check:architecture-imports": "node scripts/check-architecture-imports.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.1.0",
    "multer": "^2.2.0",
    "semver": "^7.8.5",
    "tar": "^7.5.20",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "ajv": "^8.17.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
