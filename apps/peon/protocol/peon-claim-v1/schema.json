{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peon.local/protocol/peon-claim-v1/schema.json",
  "title": "peon-claim-v1 messages",
  "description": "Strict JSON bodies for Peon-initiated claim enrollment and credential lifecycle.",
  "oneOf": [
    { "$ref": "#/$defs/claimCapabilities" },
    { "$ref": "#/$defs/claimStart" },
    { "$ref": "#/$defs/claimCreated" },
    { "$ref": "#/$defs/claimPoll" },
    { "$ref": "#/$defs/claimCancel" },
    { "$ref": "#/$defs/claimResolve" },
    { "$ref": "#/$defs/claimDetails" },
    { "$ref": "#/$defs/claimDecision" },
    { "$ref": "#/$defs/claimDecisionResult" },
    { "$ref": "#/$defs/claimStatus" },
    { "$ref": "#/$defs/claimAck" },
    { "$ref": "#/$defs/claimCompleted" },
    { "$ref": "#/$defs/claimCancelResult" },
    { "$ref": "#/$defs/credentialRotationStart" },
    { "$ref": "#/$defs/credentialRotationPoll" },
    { "$ref": "#/$defs/credentialRotationDelivery" },
    { "$ref": "#/$defs/credentialRotationAck" },
    { "$ref": "#/$defs/credentialRotationCompleted" },
    { "$ref": "#/$defs/claimError" },
    { "$ref": "#/$defs/revocationRequest" },
    { "$ref": "#/$defs/revocationResult" },
    { "$ref": "#/$defs/operatorError" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "origin": {
      "type": "string",
      "pattern": "^(https://[a-z0-9.-]+(?::[0-9]{1,5})?|http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]{1,5})?)$",
      "maxLength": 255
    },
    "identityKeyId": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
    },
    "base64url32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "requestNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "operatorCode": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$"
    },
    "credentialBearer": {
      "type": "string",
      "pattern": "^pc1\\.[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.[A-Za-z0-9_-]{43}$"
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuedAt", "requestNonce", "signature"],
      "properties": {
        "issuedAt": { "$ref": "#/$defs/timestamp" },
        "requestNonce": { "$ref": "#/$defs/requestNonce" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "publicJwk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "crv", "x"],
      "properties": {
        "kty": { "const": "OKP" },
        "crv": { "const": "Ed25519" },
        "x": { "$ref": "#/$defs/base64url32" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "publicKey"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "$ref": "#/$defs/identityKeyId" },
        "publicKey": { "$ref": "#/$defs/publicJwk" }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "platform", "architecture", "daemonVersion"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "platform": { "enum": ["darwin", "linux", "windows"] },
        "architecture": { "enum": ["arm64", "x64"] },
        "daemonVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[\\x21-\\x7E]+$"
        }
      }
    },
    "credentialDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliveryId", "credentialId", "generation", "bearer", "expiresAt"],
      "properties": {
        "deliveryId": { "$ref": "#/$defs/uuid" },
        "credentialId": { "$ref": "#/$defs/uuid" },
        "generation": { "type": "integer", "minimum": 1 },
        "bearer": { "$ref": "#/$defs/credentialBearer" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "claimCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "capability",
        "transport",
        "pollAfterMs",
        "claimTtlMs",
        "deliveryTtlMs",
        "clockSkewMs",
        "maxBodyBytes",
        "serverTime"
      ],
      "properties": {
        "type": { "const": "claim_capabilities" },
        "protocol": { "const": 1 },
        "capability": { "const": "peon-claim-v1" },
        "transport": { "const": "https-short-poll" },
        "pollAfterMs": { "const": 2000 },
        "claimTtlMs": { "const": 600000 },
        "deliveryTtlMs": { "const": 600000 },
        "clockSkewMs": { "const": 120000 },
        "maxBodyBytes": { "const": 16384 },
        "serverTime": { "$ref": "#/$defs/timestamp" }
      }
    },
    "claimStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "capability",
        "attemptId",
        "peonId",
        "serverOrigin",
        "claimNonce",
        "claimTokenHash",
        "identity",
        "display",
        "proof"
      ],
      "properties": {
        "type": { "const": "claim_start" },
        "protocol": { "const": 1 },
        "capability": { "const": "peon-claim-v1" },
        "attemptId": { "$ref": "#/$defs/uuid" },
        "peonId": { "$ref": "#/$defs/uuid" },
        "serverOrigin": { "$ref": "#/$defs/origin" },
        "claimNonce": { "$ref": "#/$defs/base64url32" },
        "claimTokenHash": { "$ref": "#/$defs/base64url32" },
        "identity": { "$ref": "#/$defs/identity" },
        "display": { "$ref": "#/$defs/display" },
        "proof": { "$ref": "#/$defs/proof" }
      }
    },
    "claimCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "claimId",
        "operatorCode",
        "operatorUrl",
        "state",
        "createdAt",
        "expiresAt",
        "pollAfterMs",
        "serverTime",
        "replayed"
      ],
      "properties": {
        "type": { "const": "claim_created" },
        "protocol": { "const": 1 },
        "claimId": { "$ref": "#/$defs/uuid" },
        "operatorCode": { "$ref": "#/$defs/operatorCode" },
        "operatorUrl": {
          "type": "string",
          "pattern": "^(?:https://[a-z0-9.-]+(?::[0-9]{1,5})?|http://(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]{1,5})?)/claim/[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$",
          "maxLength": 320
        },
        "state": { "const": "pending" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "pollAfterMs": { "const": 2000 },
        "serverTime": { "$ref": "#/$defs/timestamp" },
        "replayed": { "type": "boolean" }
      }
    },
    "claimPoll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "claimId", "proof"],
      "properties": {
        "type": { "const": "claim_poll" },
        "protocol": { "const": 1 },
        "claimId": { "$ref": "#/$defs/uuid" },
        "proof": { "$ref": "#/$defs/proof" }
      }
    },
    "claimCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "claimId", "proof"],
      "properties": {
        "type": { "const": "claim_cancel" },
        "protocol": { "const": 1 },
        "claimId": { "$ref": "#/$defs/uuid" },
        "proof": { "$ref": "#/$defs/proof" }
      }
    },
    "claimResolve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "operatorCode"],
      "properties": {
        "type": { "const": "claim_resolve" },
        "protocol": { "const": 1 },
        "operatorCode": { "$ref": "#/$defs/operatorCode" }
      }
    },
    "claimDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "claimId",
        "state",
        "peonId",
        "identityKeyId",
        "display",
        "createdAt",
        "expiresAt",
        "serverTime"
      ],
      "properties": {
        "type": { "const": "claim_details" },
        "protocol": { "const": 1 },
        "claimId": { "$ref": "#/$defs/uuid" },
        "state": { "const": "pending" },
        "peonId": { "$ref": "#/$defs/uuid" },
        "identityKeyId": { "$ref": "#/$defs/identityKeyId" },
        "display": { "$ref": "#/$defs/display" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "serverTime": { "$ref": "#/$defs/timestamp" }
      }
    },
    "claimDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "claimId", "decision"],
      "properties": {
        "type": { "const": "claim_decision" },
        "protocol": { "const": 1 },
        "claimId": { "$ref": "#/$defs/uuid" },
        "decision": { "enum": ["approve", "deny"] }
      }
    },
    "claimDecisionResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "protocol",
            "claimId",
            "state",
            "mode",
            "peonId",
            "workspaceId",
            "credentialId",
            "deliveryExpiresAt",
            "serverTime",
            "replayed"
          ],
          "properties": {
            "type": { "const": "claim_decision_result" },
            "protocol": { "const": 1 },
            "claimId": { "$ref": "#/$defs/uuid" },
            "state": { "const": "approved" },
            "mode": { "enum": ["new", "recover"] },
            "peonId": { "$ref": "#/$defs/uuid" },
            "workspaceId": { "$ref": "#/$defs/uuid" },
            "credentialId": { "$ref": "#/$defs/uuid" },
            "deliveryExpiresAt": { "$ref": "#/$defs/timestamp" },
            "serverTime": { "$ref": "#/$defs/timestamp" },
            "replayed": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "protocol", "claimId", "state", "serverTime", "replayed"],
          "properties": {
            "type": { "const": "claim_decision_result" },
            "protocol": { "const": 1 },
            "claimId": { "$ref": "#/$defs/uuid" },
            "state": { "const": "denied" },
            "serverTime": { "$ref": "#/$defs/timestamp" },
            "replayed": { "type": "boolean" }
          }
        }
      ]
    },
    "revocationRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "protocol", "credentialId"],
          "properties": {
            "type": { "const": "credential_revocation" },
            "protocol": { "const": 1 },
            "credentialId": { "$ref": "#/$defs/uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "protocol", "peonId"],
          "properties": {
            "type": { "const": "peon_revocation" },
            "protocol": { "const": 1 },
            "peonId": { "$ref": "#/$defs/uuid" }
          }
        }
      ]
    },
    "revocationResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "protocol",
            "scope",
            "code",
            "workspaceId",
            "peonId",
            "credentialId",
            "changed",
            "revokedCredentialCount",
            "evictedSocketCount",
            "revokedAt",
            "serverTime"
          ],
          "properties": {
            "type": { "const": "revocation_result" },
            "protocol": { "const": 1 },
            "scope": { "const": "credential" },
            "code": { "const": "CREDENTIAL_REVOKED" },
            "workspaceId": { "$ref": "#/$defs/uuid" },
            "peonId": { "$ref": "#/$defs/uuid" },
            "credentialId": { "$ref": "#/$defs/uuid" },
            "changed": { "type": "boolean" },
            "revokedCredentialCount": { "type": "integer", "minimum": 0, "maximum": 1 },
            "evictedSocketCount": { "type": "integer", "minimum": 0 },
            "revokedAt": { "$ref": "#/$defs/timestamp" },
            "serverTime": { "$ref": "#/$defs/timestamp" }
          },
          "allOf": [
            {
              "if": { "properties": { "changed": { "const": false } } },
              "then": {
                "properties": {
                  "revokedCredentialCount": { "const": 0 },
                  "evictedSocketCount": { "const": 0 }
                }
              }
            },
            {
              "if": { "properties": { "changed": { "const": true } } },
              "then": { "properties": { "revokedCredentialCount": { "const": 1 } } }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "protocol",
            "scope",
            "code",
            "workspaceId",
            "peonId",
            "changed",
            "revokedCredentialCount",
            "evictedSocketCount",
            "revokedAt",
            "serverTime"
          ],
          "properties": {
            "type": { "const": "revocation_result" },
            "protocol": { "const": 1 },
            "scope": { "const": "peon" },
            "code": { "const": "PEON_REVOKED" },
            "workspaceId": { "$ref": "#/$defs/uuid" },
            "peonId": { "$ref": "#/$defs/uuid" },
            "changed": { "type": "boolean" },
            "revokedCredentialCount": { "type": "integer", "minimum": 0 },
            "evictedSocketCount": { "type": "integer", "minimum": 0 },
            "revokedAt": { "$ref": "#/$defs/timestamp" },
            "serverTime": { "$ref": "#/$defs/timestamp" }
          },
          "allOf": [
            {
              "if": { "properties": { "changed": { "const": false } } },
              "then": {
                "properties": {
                  "revokedCredentialCount": { "const": 0 },
                  "evictedSocketCount": { "const": 0 }
                }
              }
            }
          ]
        }
      ]
    },
    "operatorError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "code", "message", "serverTime"],
      "properties": {
        "type": { "const": "operator_error" },
        "protocol": { "const": 1 },
        "code": { "enum": ["UNAUTHENTICATED", "CSRF_ORIGIN", "FORBIDDEN", "NOT_FOUND"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 240 },
        "serverTime": { "$ref": "#/$defs/timestamp" }
      }
    },
    "claimStatus": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "protocol", "claimId", "state", "expiresAt", "pollAfterMs", "serverTime"],
          "properties": {
            "type": { "const": "claim_status" },
            "protocol": { "const": 1 },
            "claimId": { "$ref": "#/$defs/uuid" },
            "state": { "const": "pending" },
            "expiresAt": { "$ref": "#/$defs/timestamp" },
            "pollAfterMs": { "const": 2000 },
            "serverTime": { "$ref": "#/$defs/timestamp" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "protocol",
            "claimId",
            "state",
            "mode",
            "workspaceId",
            "delivery",
            "serverTime",
            "replayed"
          ],
          "properties": {
            "type": { "const": "claim_status" },
            "protocol": { "const": 1 },
            "claimId": { "$ref": "#/$defs/uuid" },
            "state": { "const": "approved" },
            "mode": { "enum": ["new", "recover"] },
            "workspaceId": { "$ref": "#/$defs/uuid" },
            "delivery": { "$ref": "#/$defs/credentialDelivery" },
            "serverTime": { "$ref": "#/$defs/timestamp" },
            "replayed": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "protocol", "claimId", "state", "code", "serverTime"],
          "properties": {
            "type": { "const": "claim_status" },
            "protocol": { "const": 1 },
            "claimId": { "$ref": "#/$defs/uuid" },
            "state": { "enum": ["denied", "cancelled", "expired"] },
            "code": { "enum": ["CLAIM_DENIED", "CLAIM_CANCELLED", "CLAIM_EXPIRED"] },
            "serverTime": { "$ref": "#/$defs/timestamp" }
          },
          "allOf": [
            {
              "if": { "properties": { "state": { "const": "denied" } } },
              "then": { "properties": { "code": { "const": "CLAIM_DENIED" } } }
            },
            {
              "if": { "properties": { "state": { "const": "cancelled" } } },
              "then": { "properties": { "code": { "const": "CLAIM_CANCELLED" } } }
            },
            {
              "if": { "properties": { "state": { "const": "expired" } } },
              "then": { "properties": { "code": { "const": "CLAIM_EXPIRED" } } }
            }
          ]
        }
      ]
    },
    "claimAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "claimId",
        "deliveryId",
        "credentialId",
        "generation",
        "proof"
      ],
      "properties": {
        "type": { "const": "claim_ack" },
        "protocol": { "const": 1 },
        "claimId": { "$ref": "#/$defs/uuid" },
        "deliveryId": { "$ref": "#/$defs/uuid" },
        "credentialId": { "$ref": "#/$defs/uuid" },
        "generation": { "type": "integer", "minimum": 1 },
        "proof": { "$ref": "#/$defs/proof" }
      }
    },
    "claimCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "claimId",
        "state",
        "peonId",
        "workspaceId",
        "credentialId",
        "generation",
        "completedAt",
        "serverTime",
        "replayed"
      ],
      "properties": {
        "type": { "const": "claim_completed" },
        "protocol": { "const": 1 },
        "claimId": { "$ref": "#/$defs/uuid" },
        "state": { "const": "completed" },
        "peonId": { "$ref": "#/$defs/uuid" },
        "workspaceId": { "$ref": "#/$defs/uuid" },
        "credentialId": { "$ref": "#/$defs/uuid" },
        "generation": { "type": "integer", "minimum": 1 },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "serverTime": { "$ref": "#/$defs/timestamp" },
        "replayed": { "type": "boolean" }
      }
    },
    "claimCancelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "claimId", "state", "code", "changed", "terminalAt", "serverTime"],
      "properties": {
        "type": { "const": "claim_cancel_result" },
        "protocol": { "const": 1 },
        "claimId": { "$ref": "#/$defs/uuid" },
        "state": { "enum": ["cancelled", "denied", "expired"] },
        "code": { "enum": ["CLAIM_CANCELLED", "CLAIM_DENIED", "CLAIM_EXPIRED"] },
        "changed": { "type": "boolean" },
        "terminalAt": { "$ref": "#/$defs/timestamp" },
        "serverTime": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "cancelled" } } },
          "then": {
            "properties": {
              "code": { "const": "CLAIM_CANCELLED" },
              "changed": { "const": true }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "denied" } } },
          "then": {
            "properties": {
              "code": { "const": "CLAIM_DENIED" },
              "changed": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "expired" } } },
          "then": {
            "properties": {
              "code": { "const": "CLAIM_EXPIRED" },
              "changed": { "const": false }
            }
          }
        }
      ]
    },
    "credentialRotationStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "capability",
        "rotationId",
        "peonId",
        "identityKeyId",
        "currentCredentialId",
        "currentGeneration",
        "serverOrigin",
        "proof"
      ],
      "properties": {
        "type": { "const": "credential_rotation_start" },
        "protocol": { "const": 1 },
        "capability": { "const": "peon-claim-v1" },
        "rotationId": { "$ref": "#/$defs/uuid" },
        "peonId": { "$ref": "#/$defs/uuid" },
        "identityKeyId": { "$ref": "#/$defs/identityKeyId" },
        "currentCredentialId": { "$ref": "#/$defs/uuid" },
        "currentGeneration": { "type": "integer", "minimum": 1 },
        "serverOrigin": { "$ref": "#/$defs/origin" },
        "proof": { "$ref": "#/$defs/proof" }
      }
    },
    "credentialRotationPoll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "rotationId", "proof"],
      "properties": {
        "type": { "const": "credential_rotation_poll" },
        "protocol": { "const": 1 },
        "rotationId": { "$ref": "#/$defs/uuid" },
        "proof": { "$ref": "#/$defs/proof" }
      }
    },
    "credentialRotationDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "rotationId",
        "state",
        "peonId",
        "previousCredentialId",
        "previousGeneration",
        "delivery",
        "serverTime",
        "replayed"
      ],
      "properties": {
        "type": { "const": "credential_rotation_delivery" },
        "protocol": { "const": 1 },
        "rotationId": { "$ref": "#/$defs/uuid" },
        "state": { "const": "pending_ack" },
        "peonId": { "$ref": "#/$defs/uuid" },
        "previousCredentialId": { "$ref": "#/$defs/uuid" },
        "previousGeneration": { "type": "integer", "minimum": 1 },
        "delivery": { "$ref": "#/$defs/credentialDelivery" },
        "serverTime": { "$ref": "#/$defs/timestamp" },
        "replayed": { "type": "boolean" }
      }
    },
    "credentialRotationAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "rotationId",
        "deliveryId",
        "credentialId",
        "generation",
        "proof"
      ],
      "properties": {
        "type": { "const": "credential_rotation_ack" },
        "protocol": { "const": 1 },
        "rotationId": { "$ref": "#/$defs/uuid" },
        "deliveryId": { "$ref": "#/$defs/uuid" },
        "credentialId": { "$ref": "#/$defs/uuid" },
        "generation": { "type": "integer", "minimum": 2 },
        "proof": { "$ref": "#/$defs/proof" }
      }
    },
    "credentialRotationCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "rotationId",
        "state",
        "peonId",
        "credentialId",
        "generation",
        "previousCredentialId",
        "oldSocketGraceEndsAt",
        "completedAt",
        "serverTime",
        "replayed"
      ],
      "properties": {
        "type": { "const": "credential_rotation_completed" },
        "protocol": { "const": 1 },
        "rotationId": { "$ref": "#/$defs/uuid" },
        "state": { "const": "completed" },
        "peonId": { "$ref": "#/$defs/uuid" },
        "credentialId": { "$ref": "#/$defs/uuid" },
        "generation": { "type": "integer", "minimum": 2 },
        "previousCredentialId": { "$ref": "#/$defs/uuid" },
        "oldSocketGraceEndsAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "serverTime": { "$ref": "#/$defs/timestamp" },
        "replayed": { "type": "boolean" }
      }
    },
    "claimError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "code", "message", "serverTime"],
      "properties": {
        "type": { "const": "claim_error" },
        "protocol": { "const": 1 },
        "code": {
          "enum": [
            "BAD_REQUEST",
            "UNSUPPORTED_CAPABILITY",
            "UNSUPPORTED_PROTOCOL",
            "INVALID_IDENTITY",
            "BAD_SIGNATURE",
            "CLOCK_SKEW",
            "UNAUTHENTICATED",
            "FORBIDDEN",
            "REQUEST_REPLAYED",
            "ATTEMPT_ID_REUSED",
            "ATTEMPT_RETIRED",
            "ROTATION_ID_REUSED",
            "CLAIM_ACK_MISMATCH",
            "ROTATION_ACK_MISMATCH",
            "CLAIM_NOT_FOUND",
            "CLAIM_ALREADY_ACTIVE",
            "CLAIM_ALREADY_DECIDED",
            "CLAIM_DENIED",
            "CLAIM_CANCELLED",
            "CLAIM_EXPIRED",
            "CLAIM_CAPACITY_EXCEEDED",
            "IDENTITY_KEY_MISMATCH",
            "PEON_ALREADY_CLAIMED",
            "WORKSPACE_MISMATCH",
            "ENROLLMENT_METHOD_LOCKED",
            "CREDENTIAL_INVALID",
            "CREDENTIAL_REVOKED",
            "CREDENTIAL_RETIRED",
            "CREDENTIAL_GENERATION_MISMATCH",
            "ROTATION_ALREADY_ACTIVE",
            "ROTATION_EXPIRED",
            "RATE_LIMITED",
            "PERSIST_FAILED",
            "INTERNAL"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 240 },
        "serverTime": { "$ref": "#/$defs/timestamp" },
        "retryAfterMs": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["pending", "approved", "completed", "denied", "cancelled", "expired"] },
        "claimId": { "$ref": "#/$defs/uuid" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
