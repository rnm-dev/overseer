{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peon.local/protocol/reverse-command-v1/schema.json",
  "title": "Overseer to Peon reverse command protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/command" },
    { "$ref": "#/$defs/commandAccepted" },
    { "$ref": "#/$defs/commandStatusRequest" },
    { "$ref": "#/$defs/commandStatus" },
    { "$ref": "#/$defs/durableCommandResult" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "email"],
      "properties": {
        "userId": { "$ref": "#/$defs/uuid" },
        "email": { "type": "string", "minLength": 3, "maxLength": 320 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peonId"],
      "properties": {
        "peonId": { "$ref": "#/$defs/uuid" },
        "sessionId": { "$ref": "#/$defs/uuid" },
        "projectId": { "$ref": "#/$defs/uuid" },
        "transferId": { "$ref": "#/$defs/uuid" },
        "packageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "operationId": { "$ref": "#/$defs/uuid" }
      }
    },
    "sessionTurnPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "attachments": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/sessionAttachment" } },
        "permissionMode": { "const": "plan" },
        "model": { "type": "string" },
        "reasoningEffort": { "type": "string" }
      }
    },
    "sessionStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "attachments": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/sessionAttachment" } },
        "permissionMode": { "const": "plan" },
        "model": { "type": "string" },
        "reasoningEffort": { "type": "string" },
        "title": { "type": ["string", "null"], "maxLength": 512 },
        "projectId": { "$ref": "#/$defs/uuid" },
        "dir": { "type": "string", "maxLength": 4096 },
        "expectsOutcome": { "type": "boolean" },
        "agent": { "type": "string" }
      }
    },
    "sessionQueueAddPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "attachments": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/sessionAttachment" } },
        "permissionMode": { "const": "plan" },
        "model": { "type": "string" },
        "reasoningEffort": { "type": "string" },
        "startNow": { "type": "boolean" }
      }
    },
    "sessionQueueItemPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId"],
      "properties": { "itemId": { "$ref": "#/$defs/uuid" } }
    },
    "sessionAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originalName", "filename", "path", "size", "mimetype"],
      "properties": {
        "originalName": { "type": "string", "maxLength": 512 },
        "filename": { "type": "string", "maxLength": 512 },
        "path": { "type": "string", "maxLength": 4096 },
        "size": { "type": "integer", "minimum": 0 },
        "mimetype": { "type": "string", "maxLength": 128 }
      }
    },
    "sessionQueueEditPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "prompt"],
      "properties": {
        "itemId": { "$ref": "#/$defs/uuid" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    },
    "sessionMetadataPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": { "title": { "type": ["string", "null"], "maxLength": 512 } }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "capability",
        "commandId",
        "operation",
        "target",
        "actor",
        "payload",
        "requestedAt"
      ],
      "properties": {
        "type": { "const": "command" },
        "protocol": { "const": 1 },
        "capability": { "const": "reverse-command-v1" },
        "commandId": { "$ref": "#/$defs/uuid" },
        "operation": { "type": "string", "enum": ["session.detail", "session.cancel", "session.start", "session.followup", "session.queue.list", "session.queue.add", "session.queue.edit", "session.queue.remove", "session.queue.send-now", "session.metadata.patch", "session.delete", "daemon.configuration.patch", "project.create", "project.suggest-directory", "project.detail", "project.settings.get", "project.settings.update", "project.delete", "project.documentation.index", "project.documentation.read", "project.skills.list", "project.quick-links.list", "project.quick-links.create", "project.quick-links.update", "project.quick-links.delete", "update.check", "update.apply", "runtime.stats", "runtime.analytics", "runtime.quota", "runtime.capabilities", "armory.inventory", "armory.settings", "armory.refresh", "armory.install", "armory.update", "armory.enable", "armory.disable", "armory.uninstall", "armory.configure", "armory.verify", "armory.configuration.delete", "armory.package", "armory.configuration", "armory.mcp", "armory.operation"] },
        "target": { "$ref": "#/$defs/target" },
        "actor": { "$ref": "#/$defs/actor" },
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "maxProperties": 16
        },
        "expected": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "requestedAt": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "session.start" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "target": {
                "type": "object", "additionalProperties": false, "required": ["peonId"],
                "properties": { "peonId": { "$ref": "#/$defs/uuid" } }
              },
              "payload": { "$ref": "#/$defs/sessionStartPayload" },
              "expected": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "session.followup" } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/sessionTurnPayload" }, "expected": { "type": "null" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "session.queue.add" } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/sessionQueueAddPayload" }, "expected": { "type": "null" } } }
        },
        {
          "if": { "properties": { "operation": { "enum": ["session.detail", "session.cancel", "session.queue.list", "session.delete"] } }, "required": ["operation"] },
          "then": {
            "properties": {
              "payload": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
              "expected": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "enum": ["session.queue.remove", "session.queue.send-now"] } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/sessionQueueItemPayload" }, "expected": { "type": "null" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "session.queue.edit" } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/sessionQueueEditPayload" }, "expected": { "type": "null" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "session.metadata.patch" } }, "required": ["operation"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/sessionMetadataPayload" }, "expected": { "type": "null" } } }
        },
        {
          "if": { "properties": { "operation": { "pattern": "^session\\.(?!start$)" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "target": {
                "type": "object", "additionalProperties": false, "required": ["peonId", "sessionId"],
                "properties": {
                  "peonId": { "$ref": "#/$defs/uuid" },
                  "sessionId": { "$ref": "#/$defs/uuid" }
                }
              }
            }
          }
        }
      ]
    },
    "commandAccepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "commandId",
        "operation",
        "state",
        "replayed",
        "acceptedAt"
      ],
      "properties": {
        "type": { "const": "command_accepted" },
        "protocol": { "const": 1 },
        "commandId": { "$ref": "#/$defs/uuid" },
        "operation": { "enum": ["session.detail", "session.cancel", "session.start", "session.followup", "session.queue.list", "session.queue.add", "session.queue.edit", "session.queue.remove", "session.queue.send-now", "session.metadata.patch", "session.delete", "daemon.configuration.patch", "project.create", "project.suggest-directory", "project.detail", "project.settings.get", "project.settings.update", "project.delete", "project.documentation.index", "project.documentation.read", "project.skills.list", "project.quick-links.list", "project.quick-links.create", "project.quick-links.update", "project.quick-links.delete", "update.check", "update.apply", "runtime.stats", "runtime.analytics", "runtime.quota", "runtime.capabilities", "armory.inventory", "armory.settings", "armory.refresh", "armory.install", "armory.update", "armory.enable", "armory.disable", "armory.uninstall", "armory.configure", "armory.verify", "armory.configuration.delete", "armory.package", "armory.configuration", "armory.mcp", "armory.operation"] },
        "state": { "enum": ["accepted", "running"] },
        "replayed": { "type": "boolean" },
        "acceptedAt": { "type": "integer", "minimum": 0 }
      }
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "commandId",
        "operation",
        "status",
        "code",
        "completedAt",
        "result"
      ],
      "properties": {
        "type": { "const": "command_result" },
        "protocol": { "const": 1 },
        "commandId": { "$ref": "#/$defs/uuid" },
        "operation": { "enum": ["session.detail", "session.cancel", "session.start", "session.followup", "session.queue.list", "session.queue.add", "session.queue.edit", "session.queue.remove", "session.queue.send-now", "session.metadata.patch", "session.delete", "daemon.configuration.patch", "project.create", "project.suggest-directory", "project.detail", "project.settings.get", "project.settings.update", "project.delete", "project.documentation.index", "project.documentation.read", "project.skills.list", "project.quick-links.list", "project.quick-links.create", "project.quick-links.update", "project.quick-links.delete", "update.check", "update.apply", "runtime.stats", "runtime.analytics", "runtime.quota", "runtime.capabilities", "armory.inventory", "armory.settings", "armory.refresh", "armory.install", "armory.update", "armory.enable", "armory.disable", "armory.uninstall", "armory.configure", "armory.verify", "armory.configuration.delete", "armory.package", "armory.configuration", "armory.mcp", "armory.operation"] },
        "status": {
          "enum": ["applied", "noop", "rejected", "conflict", "cancelled", "failed"]
        },
        "code": { "type": "string", "minLength": 2, "maxLength": 80 },
        "message": { "type": "string", "maxLength": 1000 },
        "completedAt": { "type": "integer", "minimum": 0 },
        "result": { "type": ["object", "null"] }
      }
    },
    "durableCommandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "epoch",
        "cursor",
        "messageId",
        "priority",
        "capability",
        "payload"
      ],
      "properties": {
        "type": { "const": "durable_message" },
        "epoch": { "type": "string", "minLength": 1, "maxLength": 200 },
        "cursor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "messageId": { "$ref": "#/$defs/uuid" },
        "priority": { "enum": ["critical", "control", "normal", "bulk"] },
        "capability": { "const": "reverse-command-v1" },
        "payload": { "$ref": "#/$defs/commandResult" }
      }
    },
    "commandStatusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "commandId"],
      "properties": {
        "type": { "const": "command_status_request" },
        "protocol": { "const": 1 },
        "commandId": { "$ref": "#/$defs/uuid" }
      }
    },
    "commandStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocol", "commandId", "state"],
      "properties": {
        "type": { "const": "command_status" },
        "protocol": { "const": 1 },
        "commandId": { "$ref": "#/$defs/uuid" },
        "state": { "enum": ["unknown", "accepted", "running", "terminal"] },
        "result": { "$ref": "#/$defs/commandResult" }
      }
    }
  }
}
