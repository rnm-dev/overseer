{
  "format": "overseer-theme-v1",
  "id": "org.overseer.amber-terminal",
  "name": "Amber Terminal",
  "version": "1.0.0",
  "author": "Overseer",
  "description": "Smoked glass, phosphor amber and restrained CRT bloom.",
  "appearance": "dark",
  "capabilities": [
    "colors",
    "typography",
    "images",
    "borders",
    "motion",
    "syntax",
    "mermaid"
  ],
  "tokens": {
    "--font-display": "\"Ubuntu Mono\", ui-monospace, monospace",
    "--font-body": "\"Ubuntu Mono\", ui-monospace, monospace",
    "--ov-color-scheme": "dark",
    "--ov-canvas": "#0c0905",
    "--ov-surface": "#120d07",
    "--ov-surface-raised": "#191108",
    "--ov-surface-hover": "#241b10",
    "--ov-surface-active": "#30271a",
    "--ov-surface-disabled": "#403729",
    "--ov-edge-subtle": "#2c1d0b",
    "--ov-edge": "#493014",
    "--ov-edge-strong": "#4f7164",
    "--ov-edge-emphasis": "#69ad98",
    "--ov-ink": "#f0c56c",
    "--ov-ink-muted": "#b38b46",
    "--ov-ink-faint": "#73582e",
    "--ov-ink-disabled": "#554222",
    "--ov-accent": "#e5a83a",
    "--ov-accent-strong": "#ffd277",
    "--ov-accent-deep": "#9d681d",
    "--ov-accent-muted": "#4d3212",
    "--ov-on-accent": "#1a0f03",
    "--ov-warning": "#58b99d",
    "--ov-warning-strong": "#8bd9c0",
    "--ov-warning-deep": "#2d725f",
    "--ov-danger": "#e36845",
    "--ov-danger-deep": "#9a3f28",
    "--ov-app-background-image": "repeating-linear-gradient(0deg, rgb(255 190 76 / 0.022) 0 1px, transparent 1px 4px), radial-gradient(ellipse at 30% 24%, rgb(229 168 58 / 0.11), transparent 48%), radial-gradient(ellipse at 88% 82%, rgb(88 185 157 / 0.075), transparent 38%), linear-gradient(#0c0905, #080805)",
    "--ov-frame-image": "linear-gradient(90deg, rgb(255 210 119 / 0.72), rgb(88 185 157 / 0.52))",
    "--ov-dialog-backdrop": "repeating-linear-gradient(0deg, rgb(255 190 76 / 0.025) 0 1px, transparent 1px 4px), radial-gradient(circle at 38% 28%, rgb(229 168 58 / 0.13), transparent 42%), radial-gradient(circle at 85% 80%, rgb(88 185 157 / 0.09), transparent 36%), rgb(8 5 2 / 0.89)",
    "--ov-drawer-backdrop": "rgb(8 5 2 / 0.82)",
    "--ov-code-background": "#0a0703",
    "--ov-syntax-comment": "#806439",
    "--ov-syntax-link": "#8bd9c0",
    "--ov-syntax-selector": "#eab74f",
    "--ov-syntax-deletion": "#e36845",
    "--ov-syntax-function": "#7fcfba",
    "--ov-identity-gradient": "linear-gradient(180deg, #fff0bc 0%, #ffd277 32%, #e5a83a 64%, #69ad98 118%)",
    "--ov-identity-shadow": "drop-shadow(0 0 5px rgb(255 210 119 / 0.58)) drop-shadow(0 0 20px rgb(88 185 157 / 0.2))",
    "--ov-auth-atmosphere": "repeating-linear-gradient(0deg, rgb(255 190 76 / 0.035) 0 1px, transparent 1px 5px), radial-gradient(55% 40% at 44% 10%, rgb(229 168 58 / 0.22), transparent 70%), radial-gradient(38% 34% at 88% 88%, rgb(88 185 157 / 0.12), transparent 72%)",
    "--ov-auth-vignette": "radial-gradient(120% 80% at 50% 50%, transparent 38%, rgb(5 3 1 / 0.82))",
    "--ov-auth-wordmark-gradient": "linear-gradient(176deg, #fff6d8 4%, #ffd277 36%, #e5a83a 68%, #69ad98 118%)",
    "--ov-auth-wordmark-shadow": "0 0 16px rgb(255 210 119 / 0.42), 0 0 38px rgb(88 185 157 / 0.16)",
    "--ov-cta-gradient": "linear-gradient(180deg, #ffd277, #e5a83a 62%, #a66d1d)",
    "--ov-cta-shadow": "0 0 18px rgb(229 168 58 / 0.34), 0 12px 34px -18px rgb(229 168 58 / 0.5)",
    "--ov-cta-shadow-hover": "0 0 27px rgb(255 210 119 / 0.52), 0 17px 42px -18px rgb(229 168 58 / 0.64)",
    "--ov-cta-shadow-active": "0 0 12px rgb(229 168 58 / 0.4), 0 7px 20px -14px rgb(229 168 58 / 0.5)",
    "--ov-user-message-background": "linear-gradient(145deg, #275e51, #326f60)",
    "--ov-queued-message-background": "color-mix(in srgb, var(--ov-warning-deep) 55%, transparent)",
    "--ov-queued-message-icon": "var(--ov-warning-strong)",
    "--ov-user-message-ink": "#eafff8",
    "--ov-user-message-meta": "rgb(234 255 248 / 0.66)",
    "--ov-composer-shadow": "-12px -8px 42px -26px rgb(88 185 157 / 0.24), 12px -10px 42px -24px rgb(229 168 58 / 0.26)",
    "--ov-composer-focus-edge": "#ffd277",
    "--ov-composer-focus-shadow": "0 0 0 1px rgb(255 210 119 / 0.42), -10px 0 26px -18px rgb(88 185 157 / 0.24), 10px 8px 40px -22px rgb(229 168 58 / 0.3)",
    "--ov-transcript-composer-fade": "linear-gradient(to top, var(--ov-canvas) 0%, rgb(12 9 5 / 0.97) calc(100% - 1.1rem), transparent 100%)",
    "--ov-control-radius": "0.2rem",
    "--ov-surface-radius": "0.25rem",
    "--ov-surface-shadow": "0 0 0 1px rgb(255 210 119 / 0.035) inset, -8px 8px 28px -26px rgb(88 185 157 / 0.28), 8px 10px 28px -26px rgb(229 168 58 / 0.2)"
  }
}
