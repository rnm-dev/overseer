{
  "format": "overseer-theme-v1",
  "id": "org.overseer.blueprint",
  "name": "Blueprint",
  "version": "1.0.0",
  "author": "Overseer",
  "description": "Drafting-table navy, white hairlines and a cyan pencil.",
  "appearance": "dark",
  "capabilities": [
    "colors",
    "typography",
    "images",
    "borders",
    "motion",
    "syntax",
    "mermaid"
  ],
  "tokens": {
    "--ov-color-scheme": "dark",
    "--ov-canvas": "#0c2340",
    "--ov-surface": "#0f294b",
    "--ov-surface-raised": "#133157",
    "--ov-surface-hover": "#183a66",
    "--ov-surface-active": "#1f4679",
    "--ov-surface-disabled": "#294670",
    "--ov-edge-subtle": "#1d3b63",
    "--ov-edge": "#2a4d7a",
    "--ov-edge-strong": "#4a6f9e",
    "--ov-edge-emphasis": "#9fd8ff",
    "--ov-ink": "#eef5ff",
    "--ov-ink-muted": "#a9bfdc",
    "--ov-ink-faint": "#7290b8",
    "--ov-ink-disabled": "#56739a",
    "--ov-accent": "#6cc7ff",
    "--ov-accent-strong": "#a8e0ff",
    "--ov-accent-deep": "#2d82c4",
    "--ov-accent-muted": "#1d4c78",
    "--ov-on-accent": "#05182c",
    "--ov-warning": "#ffd36b",
    "--ov-warning-strong": "#ffe39c",
    "--ov-warning-deep": "#b8902e",
    "--ov-danger": "#ff7a7a",
    "--ov-danger-deep": "#b84040",
