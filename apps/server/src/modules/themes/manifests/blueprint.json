    "--ov-frame-image": "linear-gradient(135deg, rgb(168 224 255 / 0.7), rgb(238 245 255 / 0.35))",
    "--ov-dialog-backdrop": "repeating-linear-gradient(90deg, rgb(200 225 255 / 0.04) 0 1px, transparent 1px 24px), rgb(5 16 32 / 0.8)",
    "--ov-drawer-backdrop": "rgb(5 16 32 / 0.74)",
    "--ov-code-background": "#0a1f3a",
    "--ov-syntax-comment": "#7290b8",
    "--ov-syntax-link": "#ffd36b",
    "--ov-syntax-selector": "#b9f28a",
    "--ov-syntax-deletion": "#ff8f8f",
    "--ov-syntax-function": "#a8e0ff",
    "--ov-identity-gradient": "linear-gradient(180deg, #ffffff 0%, #d6efff 45%, #6cc7ff 100%)",
    "--ov-identity-shadow": "drop-shadow(0 0 6px rgb(108 199 255 / 0.35))",
    "--ov-auth-atmosphere": "repeating-linear-gradient(90deg, rgb(200 225 255 / 0.06) 0 1px, transparent 1px 24px), repeating-linear-gradient(0deg, rgb(200 225 255 / 0.06) 0 1px, transparent 1px 24px), radial-gradient(60% 45% at 50% 5%, rgb(108 199 255 / 0.18), transparent 70%)",
    "--ov-auth-vignette": "radial-gradient(120% 80% at 50% 50%, transparent 45%, rgb(4 14 28 / 0.65))",
    "--ov-auth-wordmark-gradient": "linear-gradient(176deg, #ffffff 10%, #d6efff 50%, #6cc7ff 100%)",
    "--ov-auth-wordmark-shadow": "0 0 18px rgb(108 199 255 / 0.3)",
    "--ov-cta-gradient": "linear-gradient(180deg, #8fd5ff, #6cc7ff 55%, #3f9fe0)",
    "--ov-cta-shadow": "0 10px 30px -16px rgb(108 199 255 / 0.55)",
    "--ov-cta-shadow-hover": "0 12px 36px -14px rgb(168 224 255 / 0.65)",
    "--ov-cta-shadow-active": "0 6px 18px -12px rgb(108 199 255 / 0.5)",
    "--ov-user-message-background": "linear-gradient(145deg, #2a5f99, #1f4c80)",
    "--ov-queued-message-background": "color-mix(in srgb, var(--ov-warning-deep) 55%, transparent)",
    "--ov-queued-message-icon": "var(--ov-warning-strong)",
    "--ov-user-message-ink": "#ffffff",
    "--ov-user-message-meta": "rgb(255 255 255 / 0.68)",
    "--ov-composer-shadow": "0 -10px 40px -22px rgb(108 199 255 / 0.4)",
    "--ov-composer-focus-edge": "#a8e0ff",
    "--ov-composer-focus-shadow": "0 0 0 1px rgb(168 224 255 / 0.6), 0 0 20px rgb(108 199 255 / 0.22)",
    "--ov-transcript-composer-fade": "linear-gradient(to top, var(--ov-canvas) 0%, rgb(12 35 64 / 0.96) calc(100% - 1.15rem), transparent 100%)",
    "--ov-control-radius": "0.2rem",
    "--ov-surface-radius": "0.25rem",
    "--ov-surface-shadow": "0 0 0 1px rgb(200 225 255 / 0.06) inset",
    "--ov-font-display": "ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
