{
  "format": "overseer-theme-v1",
  "id": "org.overseer.candy-static",
  "name": "Candy Static",
  "version": "1.0.0",
  "author": "Overseer",
  "description": "Off-white stock, electric pink, cobalt and graphic mischief.",
  "appearance": "light",
  "capabilities": [
    "colors",
    "typography",
    "images",
    "borders",
    "motion",
    "syntax",
    "mermaid"
  ],
  "tokens": {
    "--ov-color-scheme": "light",
    "--ov-canvas": "#fff8ed",
    "--ov-surface": "#fffdf8",
    "--ov-surface-raised": "#ffffff",
    "--ov-surface-hover": "#f2ecff",
    "--ov-surface-active": "#e4dbff",
    "--ov-surface-disabled": "#d8d1df",
    "--ov-edge-subtle": "#e9dfd7",
    "--ov-edge": "#252234",
    "--ov-edge-strong": "#171522",
    "--ov-edge-emphasis": "#111018",
    "--ov-ink": "#171522",
    "--ov-ink-muted": "#575166",
    "--ov-ink-faint": "#81798d",
    "--ov-ink-disabled": "#aaa3b0",
    "--ov-accent": "#f2309b",
    "--ov-accent-strong": "#d70b7d",
    "--ov-accent-deep": "#a60761",
    "--ov-accent-muted": "#ffd6eb",
    "--ov-on-accent": "#ffffff",
    "--ov-warning": "#3257d6",
    "--ov-warning-strong": "#193dbd",
    "--ov-warning-deep": "#17328e",
    "--ov-danger": "#e33a43",
    "--ov-danger-deep": "#af202b",
    "--ov-app-background-image": "radial-gradient(circle, rgb(242 48 155 / 0.09) 0 2px, transparent 2.5px) 0 0 / 28px 28px, linear-gradient(135deg, transparent 0 74%, rgb(50 87 214 / 0.055) 74% 76%, transparent 76%), linear-gradient(#fffaf1, #fff6e8)",
    "--ov-frame-image": "linear-gradient(135deg, #f2309b 0 50%, #3257d6 50% 100%)",
    "--ov-dialog-backdrop": "radial-gradient(circle at 25% 20%, rgb(242 48 155 / 0.16), transparent 35%), radial-gradient(circle at 80% 85%, rgb(50 87 214 / 0.14), transparent 38%), rgb(23 21 34 / 0.28)",
    "--ov-drawer-backdrop": "rgb(23 21 34 / 0.34)",
    "--ov-code-background": "#f8f4ff",
    "--ov-syntax-comment": "#756e80",
    "--ov-syntax-link": "#d70b7d",
    "--ov-syntax-selector": "#193dbd",
    "--ov-syntax-deletion": "#c72b37",
    "--ov-syntax-function": "#2552c8",
    "--ov-identity-gradient": "linear-gradient(180deg, #171522 0%, #3257d6 43%, #f2309b 44%, #d70b7d 100%)",
    "--ov-identity-shadow": "drop-shadow(2px 2px 0 rgb(255 255 255 / 0.9)) drop-shadow(4px 4px 0 rgb(50 87 214 / 0.22))",
    "--ov-auth-atmosphere": "radial-gradient(circle at 18% 20%, rgb(242 48 155 / 0.2), transparent 30%), radial-gradient(circle at 82% 82%, rgb(50 87 214 / 0.18), transparent 34%), repeating-linear-gradient(45deg, rgb(23 21 34 / 0.025) 0 1px, transparent 1px 18px)",
    "--ov-auth-vignette": "none",
    "--ov-auth-wordmark-gradient": "linear-gradient(110deg, #171522 0 22%, #3257d6 22% 52%, #f2309b 52% 82%, #171522 82%)",
    "--ov-auth-wordmark-shadow": "3px 3px 0 rgb(50 87 214 / 0.14)",
    "--ov-cta-gradient": "linear-gradient(100deg, #f2309b, #ff68ba 58%, #3257d6 140%)",
    "--ov-cta-shadow": "4px 4px 0 #171522",
    "--ov-cta-shadow-hover": "6px 6px 0 #3257d6",
    "--ov-cta-shadow-active": "2px 2px 0 #171522",
    "--ov-user-message-background": "linear-gradient(135deg, #dcf56d, #a9dc43 72%, #87c83c)",
    "--ov-queued-message-background": "color-mix(in srgb, var(--ov-warning-deep) 55%, transparent)",
    "--ov-queued-message-icon": "var(--ov-warning-strong)",
    "--ov-user-message-ink": "#171522",
    "--ov-user-message-meta": "rgb(23 21 34 / 0.62)",
    "--ov-composer-shadow": "5px -5px 0 rgb(50 87 214 / 0.16), -5px -2px 0 rgb(242 48 155 / 0.11)",
    "--ov-composer-focus-edge": "#f2309b",
    "--ov-composer-focus-shadow": "0 0 0 2px rgb(242 48 155 / 0.3), 5px 5px 0 rgb(50 87 214 / 0.24)",
    "--ov-transcript-composer-fade": "linear-gradient(to top, var(--ov-canvas) 0%, rgb(255 248 237 / 0.97) calc(100% - 1rem), transparent 100%)",
    "--ov-control-radius": "0.2rem",
    "--ov-surface-radius": "0.3rem",
    "--ov-surface-shadow": "3px 3px 0 rgb(50 87 214 / 0.13), -1px -1px 0 rgb(242 48 155 / 0.1)",
    "--ov-picker-focus-background": "#dfe6ff",
    "--ov-picker-focus-ink": "#17328e",
    "--ov-picker-hover-background": "#ffd9ec",
    "--ov-picker-hover-ink": "#85054e",
    "--ov-picker-active-background": "#dfe6ff",
    "--ov-picker-active-ink": "#17328e",
    "--ov-interactive-hover-background": "#ffd9ec",
    "--ov-interactive-hover-ink": "#49102f"
  }
}
