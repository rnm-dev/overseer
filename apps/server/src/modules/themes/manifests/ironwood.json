{
  "format": "overseer-theme-v1",
  "id": "org.overseer.ironwood",
  "name": "Ironwood",
  "version": "1.0.0",
  "author": "Overseer",
  "description": "Charcoal, aged bone, moss and restrained firelight.",
  "appearance": "dark",
  "capabilities": [
    "colors",
    "typography",
    "images",
    "borders",
    "motion",
    "syntax",
    "mermaid"
  ],
  "tokens": {
    "--ov-color-scheme": "dark",
    "--ov-canvas": "#0b0c0b",
    "--ov-surface": "#111311",
    "--ov-surface-raised": "#171916",
    "--ov-surface-hover": "#262a23",
    "--ov-surface-active": "#343931",
    "--ov-surface-disabled": "#474d42",
    "--ov-edge-subtle": "#20231e",
    "--ov-edge": "#262a23",
    "--ov-edge-strong": "#343931",
    "--ov-edge-emphasis": "#474d42",
    "--ov-ink": "#e7e6dc",
    "--ov-ink-muted": "#9a9c8e",
    "--ov-ink-faint": "#64685a",
    "--ov-ink-disabled": "#5c6353",
    "--ov-accent": "#86ab63",
    "--ov-accent-strong": "#a6c78a",
    "--ov-accent-deep": "#5c7a41",
    "--ov-accent-muted": "#3a4b2a",
    "--ov-on-accent": "#0b1305",
    "--ov-warning": "#d99441",
    "--ov-warning-strong": "#e6b877",
    "--ov-warning-deep": "#8d5624",
    "--ov-danger": "#d95f48",
    "--ov-danger-deep": "#a53a29",
    "--ov-app-background-image": "none",
    "--ov-frame-image": "none",
    "--ov-dialog-backdrop": "radial-gradient(circle at 50% 18%, color-mix(in srgb, var(--ov-accent) 8%, transparent), transparent 38%), rgb(2 4 3 / 0.82)",
    "--ov-drawer-backdrop": "rgb(0 0 0 / 0.66)",
    "--ov-code-background": "#111411",
    "--ov-syntax-comment": "#687061",
    "--ov-syntax-link": "#c792a6",
    "--ov-syntax-selector": "#c9b47b",
    "--ov-syntax-deletion": "#df7a68",
    "--ov-syntax-function": "#8bb8c9",
    "--ov-identity-gradient": "linear-gradient(180deg, #eeede4 0%, #d4d8c8 42%, #a7b58f 72%, #78975a 100%)",
    "--ov-identity-shadow": "drop-shadow(0 1px 1px rgb(3 5 3 / 0.76)) drop-shadow(0 0 6px rgb(134 171 99 / 0.16))",
    "--ov-auth-atmosphere": "radial-gradient(58% 42% at 50% 8%, rgb(134 171 99 / 0.2), transparent 68%), radial-gradient(46% 38% at 82% 96%, rgb(217 148 65 / 0.09), transparent 72%), radial-gradient(40% 34% at 12% 88%, rgb(134 171 99 / 0.07), transparent 74%)",
    "--ov-auth-vignette": "radial-gradient(120% 80% at 50% 50%, transparent 42%, rgb(3 5 3 / 0.72))",
    "--ov-auth-wordmark-gradient": "linear-gradient(176deg, #f4f3e8 6%, #cfd6b4 38%, var(--ov-accent) 74%, var(--ov-accent-deep) 100%)",
    "--ov-auth-wordmark-shadow": "0 0 28px rgb(134 171 99 / 0.2)",
    "--ov-cta-gradient": "linear-gradient(180deg, var(--ov-accent-strong), var(--ov-accent) 58%, #74975a)",
    "--ov-cta-shadow": "0 14px 38px -16px rgb(134 171 99 / 0.75)",
    "--ov-cta-shadow-hover": "0 20px 46px -16px rgb(134 171 99 / 0.9)",
    "--ov-cta-shadow-active": "0 8px 22px -14px rgb(134 171 99 / 0.7)",
    "--ov-user-message-background": "var(--ov-warning-deep)",
    "--ov-queued-message-background": "color-mix(in srgb, var(--ov-warning-deep) 55%, transparent)",
    "--ov-queued-message-icon": "var(--ov-warning-strong)",
    "--ov-user-message-ink": "var(--ov-ink)",
    "--ov-user-message-meta": "color-mix(in srgb, var(--ov-ink) 60%, transparent)",
    "--ov-composer-shadow": "0 -6px 28px -14px rgb(0 0 0 / 0.8)",
    "--ov-composer-focus-edge": "var(--ov-accent-strong)",
    "--ov-composer-focus-shadow": "0 0 0 1px color-mix(in srgb, var(--ov-accent-strong) 55%, transparent), 0 -6px 28px -14px rgb(0 0 0 / 0.8)",
    "--ov-transcript-composer-fade": "linear-gradient(to top, var(--ov-canvas) 0%, var(--ov-canvas) calc(100% - 1rem), transparent 100%)",
    "--ov-control-radius": "0.375rem",
    "--ov-surface-radius": "0.5rem",
    "--ov-surface-shadow": "none",
    "--ov-picker-focus-background": "color-mix(in srgb, var(--ov-edge-strong) 48%, var(--ov-surface-raised))",
    "--ov-picker-focus-ink": "var(--ov-accent-strong)",
    "--ov-picker-hover-background": "color-mix(in srgb, var(--ov-edge-strong) 48%, var(--ov-surface-raised))",
    "--ov-picker-hover-ink": "var(--ov-accent-strong)",
    "--ov-picker-active-background": "color-mix(in srgb, var(--ov-surface-active) 65%, transparent)",
    "--ov-picker-active-ink": "var(--ov-accent-strong)",
    "--ov-interactive-hover-background": "color-mix(in srgb, var(--ov-edge-strong) 48%, var(--ov-surface-raised))",
    "--ov-interactive-hover-ink": "var(--ov-ink)"
  }
}
