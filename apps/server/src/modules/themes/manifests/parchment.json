{
  "format": "overseer-theme-v1",
  "id": "org.overseer.parchment",
  "name": "Parchment",
  "version": "0.1.0",
  "author": "Overseer",
  "description": "A warm daylight foundation for the archive.",
  "appearance": "light",
  "capabilities": [
    "colors",
    "typography",
    "images",
    "borders",
    "motion",
    "syntax",
    "mermaid"
  ],
  "tokens": {
    "--ov-color-scheme": "light",
    "--ov-canvas": "#f3efe4",
    "--ov-surface": "#faf7ef",
    "--ov-surface-raised": "#ffffff",
    "--ov-surface-hover": "#e9e2d3",
    "--ov-surface-active": "#ddd3c1",
    "--ov-surface-disabled": "#cfc5b3",
    "--ov-edge-subtle": "#ebe2d1",
    "--ov-edge": "#d7cbb6",
    "--ov-edge-strong": "#b7a88f",
    "--ov-edge-emphasis": "#87775f",
    "--ov-ink": "#272a24",
    "--ov-ink-muted": "#5f6258",
    "--ov-ink-faint": "#7a7b70",
    "--ov-ink-disabled": "#99978c",
    "--ov-accent": "#597c3c",
    "--ov-accent-strong": "#3f6724",
    "--ov-accent-deep": "#36531f",
    "--ov-accent-muted": "#dce8cf",
    "--ov-on-accent": "#ffffff",
    "--ov-warning": "#a45f20",
    "--ov-warning-strong": "#87490f",
    "--ov-warning-deep": "#713b0d",
    "--ov-danger": "#b33e31",
    "--ov-danger-deep": "#8f2c23",
    "--ov-app-background-image": "radial-gradient(circle at 12% 8%, rgb(255 255 255 / 0.62), transparent 30%), radial-gradient(circle at 88% 92%, rgb(164 95 32 / 0.055), transparent 34%), repeating-linear-gradient(0deg, rgb(86 71 45 / 0.018) 0 1px, transparent 1px 4px), linear-gradient(135deg, #f5f1e8, #f0eadc)",
    "--ov-frame-image": "linear-gradient(135deg, rgb(89 124 60 / 0.5), rgb(164 95 32 / 0.34))",
    "--ov-dialog-backdrop": "radial-gradient(circle at 50% 18%, color-mix(in srgb, var(--ov-accent) 10%, transparent), transparent 38%), rgb(72 62 47 / 0.28)",
    "--ov-drawer-backdrop": "rgb(45 38 29 / 0.35)",
    "--ov-code-background": "#eee8dc",
    "--ov-syntax-comment": "#6d7165",
    "--ov-syntax-link": "#8b4567",
    "--ov-syntax-selector": "#7c651d",
    "--ov-syntax-deletion": "#a9362b",
    "--ov-syntax-function": "#28657a",
    "--ov-identity-gradient": "linear-gradient(180deg, #30362d 0%, #48533e 44%, #647651 74%, #496036 100%)",
    "--ov-identity-shadow": "drop-shadow(0 1px 0 rgb(255 255 255 / 0.72)) drop-shadow(0 2px 2px rgb(72 62 47 / 0.1))",
    "--ov-auth-atmosphere": "radial-gradient(58% 42% at 50% 8%, rgb(89 124 60 / 0.13), transparent 68%), radial-gradient(46% 38% at 82% 96%, rgb(164 95 32 / 0.08), transparent 72%)",
    "--ov-auth-vignette": "radial-gradient(120% 80% at 50% 50%, transparent 45%, rgb(123 104 76 / 0.12))",
    "--ov-auth-wordmark-gradient": "linear-gradient(176deg, #2d332a 8%, #4d5b42 52%, #647651 78%, #36531f 100%)",
    "--ov-auth-wordmark-shadow": "0 1px 0 rgb(255 255 255 / 0.65), 0 0 22px rgb(89 124 60 / 0.1)",
    "--ov-cta-gradient": "linear-gradient(180deg, var(--ov-accent-strong), var(--ov-accent) 58%, var(--ov-accent-deep))",
    "--ov-cta-shadow": "0 14px 34px -18px rgb(54 83 31 / 0.48)",
    "--ov-cta-shadow-hover": "0 18px 40px -18px rgb(54 83 31 / 0.58)",
    "--ov-cta-shadow-active": "0 8px 20px -14px rgb(54 83 31 / 0.42)",
    "--ov-user-message-background": "linear-gradient(145deg, #6f8d56, #58753f)",
    "--ov-queued-message-background": "color-mix(in srgb, var(--ov-warning-deep) 55%, transparent)",
    "--ov-queued-message-icon": "var(--ov-warning-strong)",
    "--ov-user-message-ink": "#ffffff",
    "--ov-user-message-meta": "rgb(255 255 255 / 0.68)",
    "--ov-composer-shadow": "0 -10px 34px -24px rgb(92 76 53 / 0.2)",
    "--ov-composer-focus-edge": "#8aa076",
    "--ov-composer-focus-shadow": "0 0 0 1px rgb(89 124 60 / 0.14), 0 10px 36px -24px rgb(92 76 53 / 0.18)",
    "--ov-transcript-composer-fade": "linear-gradient(to top, var(--ov-canvas) 0%, var(--ov-canvas) calc(100% - 1rem), transparent 100%)",
    "--ov-control-radius": "0.375rem",
    "--ov-surface-radius": "0.5rem",
    "--ov-surface-shadow": "0 1px 0 rgb(255 255 255 / 0.76) inset, 0 10px 30px -26px rgb(92 76 53 / 0.26)"
  }
}
