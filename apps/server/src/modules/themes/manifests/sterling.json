{
  "format": "overseer-theme-v1",
  "id": "org.overseer.sterling",
  "name": "Sterling",
  "version": "1.0.0",
  "author": "Overseer",
  "description": "Crisp white, neutral graphite and a measured blue-steel edge.",
  "appearance": "light",
  "capabilities": [
    "colors",
    "typography",
    "images",
    "borders",
    "motion",
    "syntax",
    "mermaid"
  ],
  "tokens": {
    "--ov-color-scheme": "light",
    "--ov-canvas": "#f5f6f7",
    "--ov-surface": "#ffffff",
    "--ov-surface-raised": "#ffffff",
    "--ov-surface-hover": "#eef0f2",
    "--ov-surface-active": "#e2e5e8",
    "--ov-surface-disabled": "#d5d9dd",
    "--ov-edge-subtle": "#edf0f2",
    "--ov-edge": "#dce1e5",
    "--ov-edge-strong": "#c2cad1",
    "--ov-edge-emphasis": "#8795a0",
    "--ov-ink": "#202428",
    "--ov-ink-muted": "#596168",
    "--ov-ink-faint": "#7a838b",
    "--ov-ink-disabled": "#a0a7ae",
    "--ov-accent": "#58758d",
    "--ov-accent-strong": "#3f627e",
    "--ov-accent-deep": "#304d64",
    "--ov-accent-muted": "#dce6ed",
    "--ov-on-accent": "#ffffff",
    "--ov-warning": "#9a6828",
    "--ov-warning-strong": "#7b501b",
    "--ov-warning-deep": "#684116",
    "--ov-danger": "#b2473f",
    "--ov-danger-deep": "#8e352f",
    "--ov-app-background-image": "radial-gradient(circle at 50% -12%, rgb(88 117 141 / 0.1), transparent 34%), repeating-linear-gradient(90deg, rgb(63 98 126 / 0.022) 0 1px, transparent 1px 32px), repeating-linear-gradient(0deg, rgb(63 98 126 / 0.018) 0 1px, transparent 1px 32px), linear-gradient(#f8f9fa, #f3f5f6)",
    "--ov-frame-image": "linear-gradient(135deg, rgb(88 117 141 / 0.58), rgb(157 165 173 / 0.3))",
    "--ov-dialog-backdrop": "radial-gradient(circle at 50% 18%, rgb(88 117 141 / 0.08), transparent 38%), rgb(40 48 55 / 0.22)",
    "--ov-drawer-backdrop": "rgb(35 42 48 / 0.3)",
    "--ov-code-background": "#f2f5f7",
    "--ov-syntax-comment": "#6d7780",
    "--ov-syntax-link": "#755779",
    "--ov-syntax-selector": "#786624",
    "--ov-syntax-deletion": "#a73c35",
    "--ov-syntax-function": "#326d8f",
    "--ov-identity-gradient": "linear-gradient(180deg, #1f2d37 0%, #6f899d 34%, #3f627e 62%, #26343e 100%)",
    "--ov-identity-shadow": "drop-shadow(0 1px 0 rgb(255 255 255 / 0.96)) drop-shadow(0 2px 3px rgb(48 77 100 / 0.1))",
    "--ov-auth-atmosphere": "radial-gradient(58% 42% at 50% 8%, rgb(88 117 141 / 0.11), transparent 68%), radial-gradient(42% 34% at 82% 96%, rgb(89 97 104 / 0.06), transparent 72%)",
    "--ov-auth-vignette": "radial-gradient(120% 80% at 50% 50%, transparent 48%, rgb(74 84 92 / 0.08))",
    "--ov-auth-wordmark-gradient": "linear-gradient(176deg, #1f2b34 6%, #596d7c 42%, var(--ov-accent) 72%, var(--ov-accent-deep) 100%)",
    "--ov-auth-wordmark-shadow": "0 0 26px rgb(88 117 141 / 0.13)",
    "--ov-cta-gradient": "linear-gradient(180deg, #6f8aa0, var(--ov-accent) 58%, var(--ov-accent-deep))",
    "--ov-cta-shadow": "0 12px 30px -18px rgb(48 77 100 / 0.45)",
    "--ov-cta-shadow-hover": "0 17px 36px -18px rgb(48 77 100 / 0.56)",
    "--ov-cta-shadow-active": "0 7px 18px -14px rgb(48 77 100 / 0.4)",
    "--ov-user-message-background": "linear-gradient(145deg, #638198, #49677e)",
    "--ov-queued-message-background": "color-mix(in srgb, var(--ov-accent-deep) 55%, transparent)",
    "--ov-queued-message-icon": "var(--ov-accent-strong)",
    "--ov-user-message-ink": "#ffffff",
    "--ov-user-message-meta": "rgb(255 255 255 / 0.7)",
    "--ov-composer-shadow": "0 -10px 36px -22px rgb(42 50 57 / 0.12)",
    "--ov-composer-focus-edge": "#8fa4b4",
    "--ov-composer-focus-shadow": "0 0 0 1px rgb(88 117 141 / 0.12), 0 10px 38px -22px rgb(42 50 57 / 0.11)",
    "--ov-transcript-composer-fade": "linear-gradient(to top, var(--ov-canvas) 0%, var(--ov-canvas) calc(100% - 1rem), transparent 100%)",
    "--ov-control-radius": "0.3rem",
    "--ov-surface-radius": "0.375rem",
    "--ov-surface-shadow": "0 1px 0 rgb(255 255 255 / 0.92) inset, 0 1px 2px rgb(42 50 57 / 0.045), 0 12px 28px -26px rgb(48 77 100 / 0.2)"
  }
}
