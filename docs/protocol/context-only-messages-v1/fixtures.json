  ],
  "invalidExamples": [
    {
      "schema": "publicContextMessageRequest",
      "value": { "text": "   \n", "mentions": [] },
      "error": "BAD_CONTEXT_MESSAGE"
    },
    {
      "schema": "publicContextMessageRequest",
      "value": {
        "text": "@Agent do this",
        "mentions": [
          {
            "startUtf16": 0,
            "lengthUtf16": 6,
            "principal": { "kind": "agent", "id": "codex" }
          }
        ]
      },
      "error": "BAD_MENTION"
    },
    {
      "schema": "publicContextMessageRequest",
      "value": {
        "text": "@Viktor check this",
        "mentions": [
          {
            "startUtf16": 0,
            "lengthUtf16": 0,
            "principal": { "kind": "user", "id": "user-42" }
          }
        ]
      },
      "error": "BAD_MENTION"
    },
    {
      "schema": "publicContextMessageRequest",
      "value": {
        "text": "@Viktor check this",
        "mentions": [
          {
            "startUtf16": 0,
            "lengthUtf16": 7,
            "principal": { "kind": "user", "id": "user-42" },
            "label": "client-controlled"
          }
        ]
      },
      "error": "BAD_MENTION"
    },
    {
      "schema": "mentionReadRequest",
      "value": { "eventIds": [] },
      "error": "BAD_MENTION_ACK"
    }
  ],
  "bounds": {
    "messageCodePoints": 8192,
    "messageUtf8Bytes": 16384,
    "mentionsPerMessage": 32,
    "attachmentsPerMessage": 10,
    "pendingMessages": 64,
    "providerEnvelopeUtf8Bytes": 65536,
    "mentionReadBatch": 100
  },
  "routingRules": {
    "contextEndpointCanInvokeAgent": false,
    "rawAtTextRoutesOrNotifies": false,
    "agentPickerUsesExistingAgentPath": true,
    "agentRequestsMayCarryHumanMentions": true,
    "zeroHumanMentionsAllowed": true,
    "principalKinds": ["user", "guest"],
    "clientSuppliedLabelsAccepted": false
  },
  "mentionRules": {
    "offsetUnit": "utf16-code-unit",
    "rangesOrdered": true,
    "rangesNonOverlapping": true,
    "rangesInsideText": true,
    "surrogatePairsMayBeSplit": false,
    "principalResolvedBy": "overseer-session-access",
    "labelResolvedBy": "overseer-authoritative-display-snapshot"
  },
  "deliveryRules": {
    "authority": "peon",
    "transcriptEventType": "participant_message",
    "eventMutable": false,
    "watermarkStorage": "peon-sidecar",
    "claimAt": "agent-turn-execution-start",
    "claimUpperBound": "latest-context-sequence-visible-before-claim",
    "postedDuringActiveTurn": "next-turn",
    "queuedTurnClaimsAtAdmission": false,
    "providerAcceptanceCommitsClaim": true,
    "preAcceptancePermanentFailureReleasesClaim": true,
    "logicalExactlyOnce": "one-accepted-peon-turn",
    "externalProviderExactlyOncePromised": false,
    "backlogOverflow": "reject-without-truncation"
  },
  "providerEnvelope": {
    "encoding": "canonical-json-utf8",
    "position": "immediately-before-invoking-operator-prompt",
    "order": "contextSeq-ascending",
    "topLevelFieldOrder": ["version", "kind", "messages"],
    "messageFieldOrder": ["contextSeq", "createdAt", "author", "text", "attachments", "mentions"],
    "authorFieldOrder": ["kind", "id", "label"],
    "encodedExample": "{\"version\":1,\"kind\":\"participant_context\",\"messages\":[{\"contextSeq\":12,\"createdAt\":1787846400000,\"author\":{\"kind\":\"guest\",\"id\":\"guest-7\",\"label\":\"Sam\"},\"text\":\"@Viktor please check this\",\"attachments\":[],\"mentions\":[{\"startUtf16\":0,\"lengthUtf16\":7,\"principal\":{\"kind\":\"user\",\"id\":\"user-42\",\"label\":\"Viktor\"}}]}]}",
    "contentClassification": "untrusted-participant-content",
    "providerNativeThreading": false
  },
  "attentionRules": {
    "authority": "overseer",
    "separateFromSessionAttention": true,
    "occurrenceIdentity": ["recipientPrincipal", "eventId"],
    "authorMentionNotifiesSelf": false,
    "duplicateRecipientOccurrences": "coalesced-per-event",
    "acknowledgeExactEventIds": true,
    "unknownOrAlreadyReadEventIds": "idempotent-no-op",
    "messageTextInPush": false,
    "guestPush": false,
    "realtimeScopedToRecipient": true
  },
  "lifecycleRules": {
    "editing": "unsupported-v1",
    "deletion": "unsupported-v1",
    "branchCopiedEvents": "visible-and-already-delivered-in-branch",
    "originalBranchPendingState": "unchanged",
    "sessionDeletion": "delete-delivery-sidecar",
    "contextMessageCountsAsAgentTurn": false,
    "contextMessageCreatesCompletionAttention": false,
    "clientOptimisticTranscriptRows": false,
    "clientGhostCorrelation": "commandId"
  },
  "routes": [
    {
      "authority": "peon-fleet-http",
      "method": "POST",
      "path": "/api/v1/sessions/:id/context-messages",
      "request": "fleetContextMessageRequest",
      "response": "contextMessage",
      "idempotency": "Peon-Request-Id"
    },
    {
      "authority": "overseer-public-api",
      "method": "POST",
      "path": "/api/workspaces/:wsId/peons/:peonId/sessions/:sid/context-messages",
      "request": "publicContextMessageRequest",
      "response": "contextMessage",
      "idempotency": "Peon-Request-Id"
    },
    {
      "authority": "overseer-public-api",
      "method": "POST",
      "path": "/api/workspaces/:wsId/peons/:peonId/sessions/:sid/mention-attention/read",
      "request": "mentionReadRequest",
      "response": "mentionAttentionList"
    }
  ],
  "agentMentionRoutes": [
    {
      "method": "POST",
      "path": "/sessions/:id/followup",
      "publicRequestExtension": "agentMessageRequest",
      "fleetRequestExtension": "fleetAgentMessageRequest",
      "transcriptExtension": "userMessage"
    },
    {
      "method": "POST",
      "path": "/sessions/:id/queue",
      "publicRequestExtension": "agentMessageRequest",
      "fleetRequestExtension": "fleetAgentMessageRequest",
      "transcriptExtension": "userMessage"
    },
    {
      "method": "PATCH",
      "path": "/sessions/:id/queue/:itemId",
      "publicRequestExtension": "queueEditRequest",
      "fleetRequestExtension": "fleetQueueEditRequest",
      "transcriptExtension": "userMessage"
    }
  ],
  "stableErrors": {
    "BAD_CONTEXT_MESSAGE": 400,
    "BAD_MENTION": 400,
    "BAD_MENTION_ACK": 400,
    "MENTION_PRINCIPAL_NOT_FOUND": 404,
    "UNKNOWN_SESSION": 404,
    "CONTEXT_BACKLOG_FULL": 409,
    "IDEMPOTENCY_CONFLICT": 409,
    "UNSUPPORTED_CAPABILITY": 409
  },
  "mixedVersion": {
    "capability": "context-only-messages-v1",
    "advertiseOnlyWhenComplete": true,
    "absentCapability": "hide-people-only-send-and-keep-existing-agent-send-working",
    "legacyClientEventBehavior": "ignore-or-render-bounded-generic-transcript-row-without-crashing",
    "ordinaryAgentRequestsWithoutMentions": "unchanged",
    "unknownMentionMetadata": "ignore-without-changing-agent-routing"
  }
}
