            "lengthUtf16": 7,
            "principal": { "kind": "user", "id": "user-42", "label": "Viktor" }
          }
        ]
      }
    },
    {
      "schema": "agentMessageRequest",
      "value": {
        "prompt": "@Viktor I will ask the agent too",
        "mentions": [
          {
            "startUtf16": 0,
            "lengthUtf16": 7,
            "principal": { "kind": "user", "id": "user-42" }
          }
        ]
      }
    },
    {
      "schema": "fleetAgentMessageRequest",
      "value": {
        "prompt": "@Viktor I will ask the agent too",
        "authorPrincipal": { "kind": "user", "id": "user-9", "label": "Alice" },
        "mentions": [
          {
            "startUtf16": 0,
            "lengthUtf16": 7,
            "principal": { "kind": "user", "id": "user-42", "label": "Viktor" }
          }
        ]
      }
    },
    {
      "schema": "queueEditRequest",
      "value": { "prompt": "No human mention now", "mentions": null }
    },
    {
      "schema": "userMessage",
      "value": {
        "type": "user_message",
        "text": "@Viktor I will ask the agent too",
        "commandId": "018f06c2-1c2a-7b35-8f2d-6f2f9024ac12",
        "authorPrincipal": { "kind": "user", "id": "user-9", "label": "Alice" },
        "mentions": [
          {
            "startUtf16": 0,
