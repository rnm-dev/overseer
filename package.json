{
  "name": "@rnm/overseer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Overseer monorepo — fleet control plane, operator dashboard, and the Peon daemon",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @rnm/overseer-server",
    "lint": "eslint apps/server/src apps/web/src apps/web/vite.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "verify": "npm run lint && npm run verify --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.64.0"
  }
}
