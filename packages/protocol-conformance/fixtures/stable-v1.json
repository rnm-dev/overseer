        "epoch": "projects-a",
        "revision": 2,
        "barrierSeq": 2,
        "projects": [{ "projectId": "00000000-0000-4000-8000-000000000020", "key": "alpha", "label": "Alpha", "dir": "/srv/alpha" }],
