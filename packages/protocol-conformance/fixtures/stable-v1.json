{
  "formatVersion": 1,
  "description": "Shared stable control and catalog golden frames.",
  "limits": {
    "control": 1048576,
    "durable": 1048576,
    "catalogPage": 61440
  },
  "frames": [
    {
      "name": "presence-only control hello remains valid",
      "surface": "socket",
      "schema": "socket.control.hello",
      "limit": "control",
      "frame": {
        "type": "hello",
        "protocol": 1,
        "peonId": "00000000-0000-4000-8000-000000000001"
      }
    },
    {
      "name": "current control hello advertises stable channels",
      "surface": "socket",
      "schema": "socket.control.hello",
      "limit": "control",
      "frame": {
        "type": "hello",
        "protocol": 1,
        "peonId": "00000000-0000-4000-8000-000000000001",
        "capabilities": [
          "session-catalog-v1",
          "durable-delivery-v1",
          "project-catalog-v1"
        ],
        "channels": {
          "session-catalog-v1": {
            "epoch": "sessions-a",
            "revision": 4,
            "earliestSeq": 1,
            "latestSeq": 4
          },
          "project-catalog-v1": {
            "epoch": "projects-a",
            "revision": 2,
            "earliestSeq": 1,
            "latestSeq": 2
          }
        }
      }
    },
    {
      "name": "current control hello acknowledgement",
      "surface": "socket",
      "schema": "socket.control.hello_ack",
      "limit": "control",
      "frame": {
        "type": "hello_ack",
        "protocol": 1,
        "capabilities": [
          "session-catalog-v1",
          "durable-delivery-v1",
          "project-catalog-v1"
        ],
        "channels": {
          "session-catalog-v1": {
            "epoch": "sessions-a",
            "acknowledgedSeq": 3
          },
          "project-catalog-v1": {
            "epoch": "projects-a",
            "acknowledgedSeq": 1
          }
        }
      }
    },
    {
      "name": "partial canonical negotiation is invalid",
      "surface": "socket",
      "schema": "socket.control.hello_ack",
      "limit": "control",
      "valid": false,
      "frame": {
        "type": "hello_ack",
        "protocol": 1,
        "capabilities": [
          "session-catalog-v1"
        ]
      }
    },
    {
      "name": "durable session event envelope",
      "surface": "catalog",
      "schema": "delivery.message",
      "limit": "durable",
      "frame": {
        "type": "durable_message",
        "epoch": "delivery-a",
        "cursor": "4",
        "messageId": "00000000-0000-4000-8000-000000000004",
        "priority": "normal",
        "capability": "session-catalog-v1",
        "payload": {
          "type": "session_catalog_event",
          "epoch": "sessions-a",
          "seq": 4,
          "revision": 4,
          "session": {
            "id": "session-a",
            "status": "running"
          }
        }
      }
    },
    {
      "name": "session snapshot request",
      "surface": "catalog",
      "schema": "catalog.session.snapshot_request",
      "limit": "control",
      "frame": {
        "type": "session_catalog_snapshot_request",
        "requestId": "00000000-0000-4000-8000-000000000010",
        "limit": 100
      }
    },
    {
      "name": "session snapshot page",
      "surface": "catalog",
      "schema": "catalog.session.snapshot_page",
      "limit": "catalogPage",
      "frame": {
        "type": "session_catalog_snapshot_page",
        "requestId": "00000000-0000-4000-8000-000000000010",
        "epoch": "sessions-a",
        "revision": 4,
        "barrierSeq": 4,
        "sessions": [
          {
            "id": "session-a",
            "status": "running"
          }
        ],
        "nextCursor": null,
        "hasMore": false
      }
    },
    {
      "name": "session upsert event",
      "surface": "catalog",
      "schema": "catalog.session.event",
      "limit": "catalogPage",
      "frame": {
        "type": "session_catalog_event",
        "epoch": "sessions-a",
        "seq": 5,
        "revision": 5,
        "session": {
          "id": "session-a",
          "status": "completed"
        }
      }
    },
    {
      "name": "session acknowledgement",
      "surface": "catalog",
      "schema": "catalog.session.ack",
      "limit": "control",
      "frame": {
        "type": "session_catalog_ack",
        "epoch": "sessions-a",
        "acknowledgedSeq": 5
      }
    },
    {
      "name": "project snapshot request",
      "surface": "catalog",
      "schema": "catalog.project.snapshot_request",
      "limit": "control",
      "frame": {
        "type": "project_catalog_snapshot_request",
        "requestId": "00000000-0000-4000-8000-000000000011",
        "limit": 100
      }
    },
    {
      "name": "project snapshot page",
      "surface": "catalog",
      "schema": "catalog.project.snapshot_page",
      "limit": "catalogPage",
      "frame": {
        "type": "project_catalog_snapshot_page",
        "requestId": "00000000-0000-4000-8000-000000000011",
        "epoch": "projects-a",
        "revision": 2,
        "barrierSeq": 2,
        "projects": [
          {
            "projectId": "00000000-0000-4000-8000-000000000020",
            "key": "alpha",
            "label": "Alpha",
            "dir": "/srv/alpha"
          }
        ],
        "nextCursor": null,
        "hasMore": false
      }
    },
    {
      "name": "project deletion event",
      "surface": "catalog",
      "schema": "catalog.project.event",
      "limit": "catalogPage",
      "frame": {
        "type": "project_catalog_event",
        "epoch": "projects-a",
        "seq": 3,
        "revision": 3,
        "deletedProjectId": "00000000-0000-4000-8000-000000000020"
      }
    },
    {
      "name": "project acknowledgement",
      "surface": "catalog",
      "schema": "catalog.project.ack",
      "limit": "control",
      "frame": {
        "type": "project_catalog_ack",
        "epoch": "projects-a",
        "acknowledgedSeq": 3
      }
    }
  ]
}
