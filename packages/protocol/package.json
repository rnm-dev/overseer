{
  "name": "@rnm-dev/protocol",
  "version": "1.0.0",
  "description": "Canonical Overseer ↔ Peon wire contract, schemas, fixtures, and generated TypeScript types",
  "license": "MIT",
  "author": "RNM Dev",
  "homepage": "https://github.com/rnm-dev/overseer/tree/master/packages/protocol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnm-dev/overseer.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "files": [
    "dist",
    "PROTOCOL.md",
    "reverse-command-v1"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./PROTOCOL.md": "./PROTOCOL.md",
    "./reverse-command-v1/schema.json": "./reverse-command-v1/schema.json",
    "./reverse-command-v1/fixtures.json": "./reverse-command-v1/fixtures.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "compile": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run generate:check && npm run compile && npm test",
    "prepack": "npm run verify"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
